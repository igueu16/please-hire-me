{
  "manifest_version": 3,
  "name": "please-hire-me Workday Autofill",
  "version": "0.1.0",
  "description": "Fills Workday applications from please-hire-me data and uploads the tailored resume. Never submits.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workday Autofill"
  },
  "content_scripts": [
    {
      "matches": ["*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*", "data/resumes/*"],
      "matches": ["*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*"]
    }
  ]
}
